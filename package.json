{
  "name": "luvira-memory-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A thin, client-agnostic MCP gateway for self-hosted Mem0.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
