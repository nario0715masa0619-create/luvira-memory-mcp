# Self-hosted Mem0. Do not put real secrets in this tracked file.
MEM0_BASE_URL=http://127.0.0.1:8888
MEM0_API_KEY=
MEM0_REQUEST_TIMEOUT_MS=30000

# Trusted scope configuration. MCP tool callers cannot set Mem0 user_id.
LUVIRA_SCOPE_TENANT=personal
LUVIRA_SCOPE_PROJECT=shared
LUVIRA_SCOPE_SUBJECT=owner

# MCP HTTP endpoint. Docker Compose overrides the host to 0.0.0.0 inside the container
# and publishes the port only on Windows loopback.
LUVIRA_HOST=127.0.0.1
LUVIRA_PORT=8765
LUVIRA_MCP_API_KEY=
LUVIRA_ALLOWED_ORIGINS=http://localhost:3080

# Optional multi-token auth registry (Phase 1 of project-aware scope).
# Leave unset to keep today's single-token behavior: LUVIRA_MCP_API_KEY above
# plus LUVIRA_SCOPE_* above act as the one implicit registry entry. To grant
# additional clients their own token, copy config/auth-registry.example.json
# to config/auth-registry.json (git-ignored) and populate it — see
# docs/security.md.
LUVIRA_AUTH_REGISTRY_PATH=config/auth-registry.json

# Post-MVP hardening. false (default): if the registry file above is
# missing, silently fall back to the single-token behavior described above.
# true: a missing/unreadable registry file fails Gateway startup instead —
# recommended once you are running a real multi-token registry, so an
# accidentally-missing file can never silently revert every client to one
# shared read_write credential. A registry file that exists but is malformed
# always fails closed regardless of this setting.
LUVIRA_AUTH_REGISTRY_REQUIRED=false
